<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Vasiliy Zalatov</Authors>
    <Product>Rift</Product>
    <!-- Keep only satellite assemblies for languages Rift is translated to. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
