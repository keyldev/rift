<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Vasiliy Zalatov</Authors>
    <Product>Rift</Product>
    <!-- CI overrides this with the tag on release builds (v0.10.0 -> 0.10.0). -->
    <Version>0.10.0</Version>
    <!-- Keep only satellite assemblies for languages Rift is translated to. -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
