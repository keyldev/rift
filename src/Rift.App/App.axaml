<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rift.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Rift/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#4C8DFF" RegionColor="#111113" />
        <ColorPaletteResources x:Key="Light" Accent="#2563EB" RegionColor="#F3F3F1" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Rift/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
