<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rift.App.ViewModels"
             xmlns:c="using:Rift.App.Controls"
             xmlns:app="using:Rift.App"
             x:Class="Rift.App.Views.PaneView"
             x:DataType="vm:PaneViewModel">

  <Border Classes="pane" Classes.active="{Binding IsActive}">
    <DockPanel>

      <!-- Вкладки -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Rift.Bg}"
              BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,0,1"
              Padding="6,6,6,0">
        <StackPanel Orientation="Horizontal">
          <ListBox Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <DockPanel ToolTip.Tip="{Binding Path}">
                  <c:Icon Classes="tab" DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,7,0"
                          Data="{StaticResource Icon.Folder}" />
                  <Button Classes="flat close" DockPanel.Dock="Right" Margin="6,0,0,0"
                          Command="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Close}" />
                  </Button>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="flat" Margin="2,0,0,4" Command="{Binding NewTabCommand}" ToolTip.Tip="Новая вкладка (Ctrl+T)">
            <c:Icon Data="{StaticResource Icon.Plus}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- Путь и навигация -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,0,1" Padding="6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
            <Button Classes="flat" Command="{Binding SelectedTab.BackCommand}" IsEnabled="{Binding SelectedTab.CanGoBack}" ToolTip.Tip="Назад (Alt+←)">
              <c:Icon Data="{StaticResource Icon.Back}" />
            </Button>
            <Button Classes="flat" Command="{Binding SelectedTab.ForwardCommand}" IsEnabled="{Binding SelectedTab.CanGoForward}" ToolTip.Tip="Вперёд (Alt+→)">
              <c:Icon Data="{StaticResource Icon.Forward}" />
            </Button>
            <Button Classes="flat" Command="{Binding SelectedTab.UpCommand}" ToolTip.Tip="Вверх (Alt+↑)">
              <c:Icon Data="{StaticResource Icon.Up}" />
            </Button>
          </StackPanel>
          <Button Classes="flat" DockPanel.Dock="Right" Command="{Binding SelectedTab.RefreshCommand}" ToolTip.Tip="Обновить (F5)">
            <c:Icon Data="{StaticResource Icon.Refresh}" />
          </Button>
          <Border Background="{DynamicResource Rift.Bg}" CornerRadius="6" Margin="4,0" Padding="4,0" Height="28" ClipToBounds="True">
            <ItemsControl ItemsSource="{Binding SelectedTab.Crumbs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CrumbItem">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Width="12" Height="12" Foreground="{DynamicResource Rift.Dim}" VerticalAlignment="Center"
                            Data="{StaticResource Icon.Chevron}" IsVisible="{Binding HasSeparator}" />
                    <Button Classes="flat crumb" Content="{Binding Label}"
                            Command="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).SelectedTab.NavigateToCommand}"
                            CommandParameter="{Binding Path}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </DockPanel>
      </Border>

      <!-- Статус панели -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,1,0,0" Padding="12,5">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="dim" FontSize="12" Text="{Binding SelectedTab.Path}"
                     TextTrimming="CharacterEllipsis" MaxWidth="320" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding SelectedTab.Status}" />
        </DockPanel>
      </Border>

      <!-- Заголовки колонок -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,130,110,80" Margin="14,6,20,2">
        <Grid.Styles>
          <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
          </Style>
        </Grid.Styles>
        <TextBlock Text="Имя" />
        <TextBlock Grid.Column="1" Text="Изменён" />
        <TextBlock Grid.Column="2" Text="Тип" />
        <TextBlock Grid.Column="3" Text="Размер" HorizontalAlignment="Right" />
      </Grid>

      <!-- Файлы -->
      <Panel>
        <ListBox x:Name="Files" Classes="files" SelectionMode="Multiple"
                 ItemsSource="{Binding SelectedTab.Items}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItem">
              <Grid ColumnDefinitions="*,130,110,80" Background="Transparent">
                <DockPanel>
                  <c:Icon DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,9,0"
                          Data="{Binding Kind, Converter={x:Static app:Converters.KindToIcon}}"
                          Foreground="{Binding Kind, Converter={x:Static app:Converters.KindToBrush}}"
                          Fill="{Binding Kind, Converter={x:Static app:Converters.KindToFill}}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding DateText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding KindText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Classes="muted" Text="{Binding SizeText}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{Binding SelectedTab.Error}"
                   IsVisible="{Binding SelectedTab.Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
