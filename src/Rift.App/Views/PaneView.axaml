<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Rift.App.ViewModels"
             xmlns:c="using:Rift.App.Controls"
             xmlns:app="using:Rift.App"
             xmlns:l="using:Rift.Core.Localization"
             xmlns:core="using:Rift.Core"
             x:Class="Rift.App.Views.PaneView"
             x:DataType="vm:PaneViewModel">

  <UserControl.Styles>
    <!-- The search box's hint, gone when a narrow pane shrinks the box to its icon -->
    <Style Selector="TextBox.search">
      <Setter Property="PlaceholderText" Value="{x:Static l:Strings.SearchPlaceholder}" />
    </Style>
    <Style Selector="Border.pane.narrow TextBox.search:not(:focus-within)">
      <Setter Property="PlaceholderText" Value="" />
    </Style>

    <!-- Details: one row per file with the columns from the header -->
    <Style Selector="ListBox.files">
      <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="vm:FileItem">
              <DockPanel Background="Transparent" Classes.hidden="{Binding IsHidden}">
                <TextBlock DockPanel.Dock="Right" Classes="muted cell" Text="{Binding SizeText}" TextAlignment="Right" Padding="0,0,7,0"
                           Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.SizeWidth}" IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).Columns.Size}" />
                <TextBlock DockPanel.Dock="Right" Classes="muted cell" Text="{Binding KindText}" Padding="6,0,10,0"
                           Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.TypeWidth}" IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).Columns.Type}" />
                <TextBlock DockPanel.Dock="Right" Classes="muted cell" Text="{Binding CreatedText}" Padding="6,0,10,0"
                           Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.CreatedWidth}" IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).Columns.Created}" />
                <TextBlock DockPanel.Dock="Right" Classes="muted cell" Text="{Binding DateText}" Padding="6,0,10,0"
                           Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.ModifiedWidth}" IsVisible="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).Columns.Modified}" />
                <DockPanel>
                  <Panel DockPanel.Dock="Left" Width="17" Height="17" Margin="0,0,9,0">
                    <c:Icon IsVisible="{Binding !HasIcon}"
                            Data="{Binding Kind, Converter={x:Static app:Converters.KindToIcon}}"
                            Foreground="{Binding Kind, Converter={x:Static app:Converters.KindToBrush}}"
                            Fill="{Binding Kind, Converter={x:Static app:Converters.KindToFill}}" />
                    <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="16" Height="16"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                  </Panel>
                  <Panel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               IsVisible="{Binding !IsRenaming}" Margin="0,0,10,0" />
                    <c:RenameBox Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}"
                                 MinHeight="24" Padding="5,2" Margin="-6,0,8,0" VerticalAlignment="Center"
                                 VerticalContentAlignment="Center" />
                  </Panel>
                </DockPanel>
              </DockPanel>
            </DataTemplate>
      </Setter>
    </Style>

    <!-- Tiles: icon or small thumbnail with name, type and size -->
    <Style Selector="ListBox.files.tiles">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <c:VirtualizingWrapPanel ItemWidth="250" ItemHeight="64" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="vm:FileItem">
          <DockPanel Background="Transparent" Classes.hidden="{Binding IsHidden}">
            <Panel DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center">
              <Panel Width="48" Height="48">
                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <c:Icon IsVisible="{Binding !HasThumbnail}" Width="36" Height="36" StrokeThickness="1.4"
                            Data="{Binding Kind, Converter={x:Static app:Converters.KindToIcon}}"
                            Foreground="{Binding Kind, Converter={x:Static app:Converters.KindToBrush}}"
                            Fill="{Binding Kind, Converter={x:Static app:Converters.KindToFill}}" />
                  </Panel>
            </Panel>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <Panel>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsRenaming}" />
                <c:RenameBox Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}" MinHeight="24" Padding="5,2" />
              </Panel>
              <TextBlock Classes="muted" FontSize="11" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="dim" FontSize="11" Text="{Binding SizeText}" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </Setter>
    </Style>

    <!-- Thumbnails: big pictures, name underneath -->
    <Style Selector="ListBox.files.thumbs">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <c:VirtualizingWrapPanel ItemWidth="136" ItemHeight="164" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="vm:FileItem">
          <DockPanel Background="Transparent" Classes.hidden="{Binding IsHidden}">
            <Panel DockPanel.Dock="Bottom" Height="36" Margin="0,4,0,0">
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                         TextAlignment="Center" FontSize="12" IsVisible="{Binding !IsRenaming}" />
              <c:RenameBox Text="{Binding EditName, Mode=TwoWay}" IsVisible="{Binding IsRenaming}" MinHeight="24" Padding="5,2"
                           VerticalAlignment="Top" />
            </Panel>
            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Panel Width="112" Height="112">
                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <c:Icon IsVisible="{Binding !HasThumbnail}" Width="64" Height="64" StrokeThickness="1.4"
                            Data="{Binding Kind, Converter={x:Static app:Converters.KindToIcon}}"
                            Foreground="{Binding Kind, Converter={x:Static app:Converters.KindToBrush}}"
                            Fill="{Binding Kind, Converter={x:Static app:Converters.KindToFill}}" />
                  </Panel>
            </Panel>
          </DockPanel>
        </DataTemplate>
      </Setter>
    </Style>

    <Style Selector="ListBox.files.tiles ListBoxItem, ListBox.files.thumbs ListBoxItem">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="PaneRoot" Classes="pane" Classes.active="{Binding IsActive}">
    <Panel>
    <DockPanel>

      <!-- Tabs -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Rift.Bg}"
              BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,0,1"
              Padding="6,6,6,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="flat" Margin="2,0,0,4" Command="{Binding NewTabCommand}" ToolTip.Tip="{x:Static l:Strings.TipNewTab}">
            <c:Icon Data="{StaticResource Icon.Plus}" />
          </Button>
          <!-- Tabs: drag to reorder, to another pane, or to a pane's edge to split; middle click closes; right-click for more -->
          <ListBox x:Name="TabStrip" Classes="tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                   HorizontalAlignment="Left">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TabViewModel">
                <DockPanel ToolTip.Tip="{Binding DisplayPath}">
                  <Panel DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,7,0">
                    <c:Icon Classes="tab" Data="{StaticResource Icon.Folder}" IsVisible="{Binding !IsPinned}" />
                    <c:Icon Classes="tab" Data="{StaticResource Icon.PinTab}" IsVisible="{Binding IsPinned}" />
                  </Panel>
                  <Button Classes="flat close" DockPanel.Dock="Right" Margin="6,0,0,0" IsVisible="{Binding !IsPinned}"
                          Command="{Binding $parent[ListBox].((vm:PaneViewModel)DataContext).CloseTabCommand}"
                          CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource Icon.Close}" />
                  </Button>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Path and navigation -->
      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,0,1" Padding="6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
            <Button Classes="flat" Command="{Binding SelectedTab.BackCommand}" IsEnabled="{Binding SelectedTab.CanGoBack}" ToolTip.Tip="{x:Static l:Strings.TipBack}">
              <c:Icon Data="{StaticResource Icon.Back}" />
            </Button>
            <Button Classes="flat" Command="{Binding SelectedTab.ForwardCommand}" IsEnabled="{Binding SelectedTab.CanGoForward}" ToolTip.Tip="{x:Static l:Strings.TipForward}">
              <c:Icon Data="{StaticResource Icon.Forward}" />
            </Button>
            <Button Classes="flat" Command="{Binding SelectedTab.UpCommand}" ToolTip.Tip="{x:Static l:Strings.TipUp}">
              <c:Icon Data="{StaticResource Icon.Up}" />
            </Button>
          </StackPanel>
          <Button Classes="flat" DockPanel.Dock="Right" Command="{Binding SelectedTab.RefreshCommand}" ToolTip.Tip="{x:Static l:Strings.TipRefresh}">
            <c:Icon Data="{StaticResource Icon.Refresh}" />
          </Button>
          <StackPanel DockPanel.Dock="Right" Classes="viewbuttons" Orientation="Horizontal" Spacing="1" Margin="4,0,0,0">
            <Button Classes="flat" Classes.on="{Binding SelectedTab.IsDetails}" Command="{Binding SelectedTab.SetViewCommand}"
                    CommandParameter="{x:Static vm:ViewMode.Details}" ToolTip.Tip="{x:Static l:Strings.TipViewDetails}">
              <c:Icon Data="{StaticResource Icon.ViewDetails}" />
            </Button>
            <Button Classes="flat" Classes.on="{Binding SelectedTab.IsTiles}" Command="{Binding SelectedTab.SetViewCommand}"
                    CommandParameter="{x:Static vm:ViewMode.Tiles}" ToolTip.Tip="{x:Static l:Strings.TipViewTiles}">
              <c:Icon Data="{StaticResource Icon.ViewTiles}" />
            </Button>
            <Button Classes="flat" Classes.on="{Binding SelectedTab.IsThumbnails}" Command="{Binding SelectedTab.SetViewCommand}"
                    CommandParameter="{x:Static vm:ViewMode.Thumbnails}" ToolTip.Tip="{x:Static l:Strings.TipViewThumbnails}">
              <c:Icon Data="{StaticResource Icon.ViewGrid}" />
            </Button>
            <Button Classes="flat" Classes.on="{Binding IsPreviewOpen}" Command="{Binding TogglePreviewCommand}"
                    ToolTip.Tip="{x:Static l:Strings.TipPreview}">
              <c:Icon Data="{StaticResource Icon.Preview}" />
            </Button>
          </StackPanel>
          <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Classes="search" Margin="4,0,2,0"
                   ToolTip.Tip="{x:Static l:Strings.TipSearch}"
                   IsEnabled="{Binding SelectedTab.SearchRoot, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox.InnerLeftContent>
              <c:Icon Width="14" Height="14" Margin="8,0,0,0" Foreground="{DynamicResource Rift.Dim}" Data="{StaticResource Icon.Search}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Border x:Name="AddressBar" Background="{DynamicResource Rift.Bg}" CornerRadius="6" Margin="4,0" Padding="4,0" Height="28" ClipToBounds="True"
                  Cursor="Ibeam">
            <Panel>
            <AutoCompleteBox x:Name="AddressBox" Classes="address" IsVisible="{Binding SelectedTab.IsEditingAddress}"
                             Text="{Binding SelectedTab.AddressText, Mode=TwoWay}" FilterMode="None" MinimumPrefixLength="1"
                             MinimumPopulateDelay="0:0:0.08" MaxDropDownHeight="320" />
            <ItemsControl ItemsSource="{Binding SelectedTab.Crumbs}" VerticalAlignment="Center" Cursor="Arrow"
                          IsVisible="{Binding !SelectedTab.IsEditingAddress}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <c:CrumbPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CrumbItem">
                  <StackPanel Orientation="Horizontal">
                    <c:Icon Width="12" Height="12" Foreground="{DynamicResource Rift.Dim}" VerticalAlignment="Center"
                            Data="{StaticResource Icon.Chevron}" IsVisible="{Binding HasSeparator}" />
                    <Button Classes="flat crumb" Content="{Binding Label}"
                            Command="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).SelectedTab.NavigateToCommand}"
                            CommandParameter="{Binding Path}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Panel>
          </Border>
        </DockPanel>
      </Border>

      <!-- Pane status -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,1,0,0" Padding="12,5">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Classes="dim" FontSize="12" Text="{Binding SelectedTab.DisplayPath}"
                     TextTrimming="CharacterEllipsis" MaxWidth="320" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding SelectedTab.Status}" />
        </DockPanel>
      </Border>

      <!-- A search is running -->
      <ProgressBar DockPanel.Dock="Top" Classes="busy" IsIndeterminate="True" IsVisible="{Binding SelectedTab.IsBusy}" />

      <!-- Column headers: click sorts, dragging a column's left edge resizes it, right-click picks columns -->
      <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="8,4,14,0" Height="24" Background="Transparent"
                 IsVisible="{Binding SelectedTab.IsDetails}">
        <Panel DockPanel.Dock="Right" Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.SizeWidth}" IsVisible="{Binding Columns.Size}">
          <Button Classes="flat header" Tag="{x:Static core:SortColumn.Size}" Click="OnHeaderClick">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
              <c:Icon Classes="sort" Data="{Binding SelectedTab.SizeSort, Converter={x:Static app:Converters.SortIcon}}" />
              <TextBlock Text="{x:Static l:Strings.ColumnSize}" />
            </StackPanel>
          </Button>
          <Thumb Classes="resize" Tag="{x:Static core:SortColumn.Size}" DragDelta="OnColumnResize" />
        </Panel>
        <Panel DockPanel.Dock="Right" Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.TypeWidth}" IsVisible="{Binding Columns.Type}">
          <Button Classes="flat header" Tag="{x:Static core:SortColumn.Type}" Click="OnHeaderClick">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
              <TextBlock Text="{Binding SelectedTab.TypeColumn}" />
              <c:Icon Classes="sort" Data="{Binding SelectedTab.TypeSort, Converter={x:Static app:Converters.SortIcon}}" />
            </StackPanel>
          </Button>
          <Thumb Classes="resize" Tag="{x:Static core:SortColumn.Type}" DragDelta="OnColumnResize" />
        </Panel>
        <Panel DockPanel.Dock="Right" Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.CreatedWidth}" IsVisible="{Binding Columns.Created}">
          <Button Classes="flat header" Tag="{x:Static core:SortColumn.Created}" Click="OnHeaderClick">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
              <TextBlock Text="{x:Static l:Strings.ColumnCreated}" />
              <c:Icon Classes="sort" Data="{Binding SelectedTab.CreatedSort, Converter={x:Static app:Converters.SortIcon}}" />
            </StackPanel>
          </Button>
          <Thumb Classes="resize" Tag="{x:Static core:SortColumn.Created}" DragDelta="OnColumnResize" />
        </Panel>
        <Panel DockPanel.Dock="Right" Width="{Binding Source={x:Static vm:ViewOptions.Current}, Path=Columns.ModifiedWidth}" IsVisible="{Binding Columns.Modified}">
          <Button Classes="flat header" Tag="{x:Static core:SortColumn.Modified}" Click="OnHeaderClick">
            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
              <TextBlock Text="{Binding SelectedTab.DateColumn}" />
              <c:Icon Classes="sort" Data="{Binding SelectedTab.ModifiedSort, Converter={x:Static app:Converters.SortIcon}}" />
            </StackPanel>
          </Button>
          <Thumb Classes="resize" Tag="{x:Static core:SortColumn.Modified}" DragDelta="OnColumnResize" />
        </Panel>
        <Button Classes="flat header" Tag="{x:Static core:SortColumn.Name}" Click="OnHeaderClick">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Text="{x:Static l:Strings.ColumnName}" />
            <c:Icon Classes="sort" Data="{Binding SelectedTab.NameSort, Converter={x:Static app:Converters.SortIcon}}" />
          </StackPanel>
        </Button>
      </DockPanel>

      <!-- Type-to-filter: shown while a filter is active -->
      <Border DockPanel.Dock="Bottom" Classes="filterbar" IsVisible="{Binding SelectedTab.IsFiltered}">
        <DockPanel>
          <c:Icon DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" Data="{StaticResource Icon.Filter}"
                  Foreground="{DynamicResource Rift.Accent}" />
          <Button DockPanel.Dock="Right" Classes="flat" Padding="3" Click="OnClearFilter" ToolTip.Tip="{x:Static l:Strings.TipClearFilter}">
            <c:Icon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
          </Button>
          <TextBlock VerticalAlignment="Center" FontSize="12">
            <Run Text="{x:Static l:Strings.FilterLabel}" Foreground="{DynamicResource Rift.Dim}" /><Run Text=": " Foreground="{DynamicResource Rift.Dim}" /><Run Text="{Binding SelectedTab.Filter}" FontWeight="SemiBold" />
          </TextBlock>
        </DockPanel>
      </Border>

      <!-- Preview pane (Alt+P), on the right of the files -->
      <Border DockPanel.Dock="Right" Classes="preview" Width="{Binding PreviewWidth}" IsVisible="{Binding IsPreviewOpen}">
        <Panel>
          <DockPanel Margin="16,14" IsVisible="{Binding !Preview.IsEmpty}">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Preview.Title}" FontWeight="SemiBold" FontSize="14"
                       TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Preview.Lines}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PreviewLine">
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Left" Classes="dim" FontSize="12" Width="96" Text="{Binding Label}" />
                    <SelectableTextBlock FontSize="12" Text="{Binding Value}" TextWrapping="Wrap" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Panel>
              <Image Source="{Binding Preview.Image}" IsVisible="{Binding Preview.HasImage}" Stretch="Uniform"
                     StretchDirection="DownOnly" VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <Border Classes="previewtext" IsVisible="{Binding Preview.HasText}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Classes="mono" Text="{Binding Preview.Text}" />
                </ScrollViewer>
              </Border>
            </Panel>
          </DockPanel>
          <TextBlock Classes="muted" Text="{x:Static l:Strings.PreviewNothing}" IsVisible="{Binding Preview.IsEmpty}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" />
          <Thumb Classes="resize" Margin="-4,0,0,0" DragDelta="OnPreviewResize" />
        </Panel>
      </Border>

      <!-- Files -->
      <Panel>
        <ListBox x:Name="Files" Classes="files" SelectionMode="Multiple"
                 Classes.tiles="{Binding SelectedTab.IsTiles}" Classes.thumbs="{Binding SelectedTab.IsThumbnails}"
                 ItemsSource="{Binding SelectedTab.Items}">
        </ListBox>
        <TextBlock Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="24" MaxWidth="420" Text="{Binding SelectedTab.Notice}"
                   IsVisible="{Binding SelectedTab.Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Drop zone while files are dragged over this pane -->
        <Border Classes="dropzone" Classes.copy="{Binding DropIsCopy}" IsVisible="{Binding IsDropTarget}"
                IsHitTestVisible="False" Margin="6" CornerRadius="10" BorderThickness="2">
          <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:Icon Width="28" Height="28" StrokeThickness="1.6"
                    Data="{Binding DropIsCopy, Converter={x:Static app:Converters.DropIcon}}" />
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding DropTitle}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Classes="muted" Text="{Binding DropHint}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </DockPanel>

    <!-- Where a dragged tab would go: the whole pane (as a tab) or one of its halves (as a new split) -->
    <Border x:Name="TabDropOverlay" Classes="tabdrop" IsVisible="False" IsHitTestVisible="False" />
    </Panel>
  </Border>
</UserControl>
