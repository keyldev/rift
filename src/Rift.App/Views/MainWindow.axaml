<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rift.App.ViewModels"
        xmlns:v="using:Rift.App.Views"
        xmlns:c="using:Rift.App.Controls"
        xmlns:app="using:Rift.App"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:l="using:Rift.Core.Localization"
        x:Class="Rift.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Rift"
        Icon="/Assets/rift.ico"
        Width="1280" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

  <!-- Key bindings come from ViewModels/AppCommands.cs (and the user's changes), see MainWindow.ApplyHotkeys. -->

  <Grid RowDefinitions="44,*,28">

    <!-- Fully custom title bar: dragging via the TitleBar role, interactive elements are marked User. -->
    <Border x:Name="TitleBar" Background="{DynamicResource Rift.Chrome}"
            BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,0,1"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <DockPanel Margin="14,0,0,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <StackPanel.RenderTransform>
              <SkewTransform AngleX="-12" />
            </StackPanel.RenderTransform>
            <Border Width="6" Height="16" CornerRadius="2" Background="{DynamicResource Rift.Accent}" />
            <Border Width="6" Height="16" CornerRadius="2" Background="{DynamicResource Rift.Text}" />
          </StackPanel>
          <TextBlock Text="Rift" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Height="44">
          <StackPanel.Styles>
            <Style Selector="Button.caption">
              <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
              <Setter Property="Width" Value="46" />
              <Setter Property="Height" Value="44" />
              <Setter Property="CornerRadius" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.caption c|Icon">
              <Setter Property="Width" Value="15" />
              <Setter Property="Height" Value="15" />
              <Setter Property="StrokeThickness" Value="1.5" />
            </Style>
            <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="#C42B1C" />
              <Setter Property="Foreground" Value="White" />
            </Style>
          </StackPanel.Styles>
          <Button Classes="flat caption" Click="OnMinimize" ToolTip.Tip="{x:Static l:Strings.TipMinimize}">
            <c:Icon Data="{StaticResource Icon.Minimize}" />
          </Button>
          <Button Classes="flat caption" Click="OnMaximize" ToolTip.Tip="{x:Static l:Strings.TipMaximize}">
            <c:Icon Data="{StaticResource Icon.Single}" />
          </Button>
          <Button Classes="flat caption close" Click="OnClose" ToolTip.Tip="{x:Static l:Strings.TipClose}">
            <c:Icon Data="{StaticResource Icon.Close}" />
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0">
          <StackPanel.Styles>
            <Style Selector="Button">
              <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
            </Style>
          </StackPanel.Styles>
          <Button Classes="flat" Classes.on="{Binding IsZoomed}" Command="{Binding ToggleZoomCommand}"
                  IsEnabled="{Binding HasManyPanes}" ToolTip.Tip="{x:Static l:Strings.TipZoom}">
            <c:Icon Data="{StaticResource Icon.Single}" />
          </Button>
          <Button Classes="flat" Command="{Binding SplitRightCommand}" ToolTip.Tip="{x:Static l:Strings.TipSplitRight}">
            <c:Icon Data="{StaticResource Icon.Split}" />
          </Button>
          <Button Classes="flat" Command="{Binding SplitDownCommand}" ToolTip.Tip="{x:Static l:Strings.TipSplitDown}">
            <c:Icon Data="{StaticResource Icon.SplitDown}" />
          </Button>
          <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Rift.Line}" />
          <Button Classes="flat" Classes.on="{Binding View.ShowHidden}" Command="{Binding ToggleHiddenCommand}" ToolTip.Tip="{x:Static l:Strings.TipHidden}">
            <c:Icon Data="{Binding View.ShowHidden, Converter={x:Static app:Converters.HiddenIcon}}" />
          </Button>
          <Button Classes="flat" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{x:Static l:Strings.TipSettings}">
            <c:Icon Data="{StaticResource Icon.Settings}" />
          </Button>
          <Button Classes="flat" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{x:Static l:Strings.TipTheme}">
            <c:Icon Data="{Binding IsDark, Converter={x:Static app:Converters.ThemeIcon}}" />
          </Button>
        </StackPanel>

        <Panel />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">

      <!-- Sidebar -->
      <Border Background="{DynamicResource Rift.Chrome}" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,0,1,0">
        <DockPanel>
        <ScrollViewer>
          <StackPanel Margin="8,12" Spacing="2">
            <StackPanel Spacing="2" Margin="0,0,0,16" IsVisible="{Binding HasPinned}">
              <TextBlock Classes="section" Text="{x:Static l:Strings.SectionPinned}" />
              <ItemsControl ItemsSource="{Binding Pinned}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarItem">
                    <Button Classes="flat nav"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSidebarItemCommand}"
                            CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{x:Static l:Strings.MenuUnpin}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UnpinCommand}"
                                    CommandParameter="{Binding}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <c:Icon Data="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="6" Margin="0,0,0,16" IsVisible="{Binding HasTags}">
              <TextBlock Classes="section" Text="{x:Static l:Strings.SidebarTags}" />
              <ItemsControl ItemsSource="{Binding Tags}" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SidebarTag">
                    <Button Classes="tagchip" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenTagCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="section" Text="{x:Static l:Strings.SectionQuickAccess}" />
            <ItemsControl ItemsSource="{Binding QuickAccess}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarItem">
                  <Button Classes="flat nav"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSidebarItemCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Tip}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Icon Data="{Binding Icon, Converter={x:Static app:Converters.ResourceToGeometry}}" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="{x:Static l:Strings.SectionDrives}" Margin="8,16,0,6" />
            <ItemsControl ItemsSource="{Binding Drives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SidebarItem">
                  <Button Classes="flat nav"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSidebarItemCommand}"
                          CommandParameter="{Binding}">
                    <DockPanel>
                      <c:Icon DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top"
                              Data="{Binding Icon, Converter={x:Static app:Converters.ResourceToGeometry}}" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Classes="usage" Minimum="0" Maximum="100"
                                     Value="{Binding Used, Converter={x:Static app:Converters.FractionToPercent}}" />
                        <TextBlock Classes="dim" FontSize="11" Text="{Binding Meta}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Panes, in the split layout (built in code from the layout tree) -->
      <c:LayoutHost x:Name="Panes" Grid.Column="1" Margin="8" />

      <!-- Running operations, bottom right -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Operations.Items}" Width="320"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OperationViewModel">
            <Border Classes="card" Padding="12,10">
              <DockPanel>
                <c:Icon DockPanel.Dock="Left" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource Rift.Accent}"
                        Data="{Binding State, Converter={x:Static app:Converters.OperationIcon}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,-4,-6,0">
                  <Button Classes="flat" Command="{Binding TogglePauseCommand}" IsVisible="{Binding ShowPause}"
                          ToolTip.Tip="{x:Static l:Strings.TipPause}">
                    <Panel>
                      <c:Icon Data="{StaticResource Icon.Pause}" IsVisible="{Binding !IsPaused}" />
                      <c:Icon Data="{StaticResource Icon.Play}" IsVisible="{Binding IsPaused}" />
                    </Panel>
                  </Button>
                  <Button Classes="flat" Command="{Binding CancelCommand}" IsVisible="{Binding IsActive}"
                          ToolTip.Tip="{x:Static l:Strings.TipCancel}">
                    <c:Icon Data="{StaticResource Icon.Close}" />
                  </Button>
                  <Button Classes="flat" Command="{Binding DismissCommand}" IsVisible="{Binding IsFinished}"
                          ToolTip.Tip="{x:Static l:Strings.TipDismiss}">
                    <c:Icon Data="{StaticResource Icon.Close}" />
                  </Button>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Classes="usage" Minimum="0" Maximum="100" Value="{Binding Percent}"
                               IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsActive}" />
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="dim" FontSize="11" Text="{Binding StateText}" />
                    <TextBlock Classes="dim" FontSize="11" Text="{Binding Detail}" />
                  </DockPanel>
                  <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Rift.Danger}"
                             Text="{Binding ErrorText}"
                             IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource Rift.Chrome}" BorderBrush="{DynamicResource Rift.Line}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="18" Margin="12,0" VerticalAlignment="Center">
        <StackPanel.Styles>
          <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
          </Style>
        </StackPanel.Styles>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="Ctrl+K" /></Border><TextBlock Text="{x:Static l:Strings.HintPalette}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="Tab" /></Border><TextBlock Text="{x:Static l:Strings.HintOtherPane}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="F5" /></Border><TextBlock Text="{x:Static l:Strings.HintCopy}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="F6" /></Border><TextBlock Text="{x:Static l:Strings.HintMove}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="F2" /></Border><TextBlock Text="{x:Static l:Strings.HintRename}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="Del" /></Border><TextBlock Text="{x:Static l:Strings.HintDelete}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="Ctrl+Shift+N" /></Border><TextBlock Text="{x:Static l:Strings.HintNewFolder}" /></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Classes="kbd"><TextBlock Text="Ctrl+Z" /></Border><TextBlock Text="{x:Static l:Strings.HintUndo}" /></StackPanel>
      </StackPanel>
    </Border>

    <!-- Command palette (Ctrl+K): commands, places, recent folders, tabs, typed paths -->
    <Border x:Name="PaletteScrim" Grid.RowSpan="3" Background="{DynamicResource Rift.Scrim}" IsVisible="{Binding Palette.IsOpen}">
      <Border Classes="card palette" Width="580" Margin="0,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
              Background="{DynamicResource Rift.Panel}" CornerRadius="12">
        <DockPanel>
          <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Classes="palette" Text="{Binding Palette.Query, Mode=TwoWay}"
                   PlaceholderText="{x:Static l:Strings.PalettePlaceholder}">
            <TextBox.InnerLeftContent>
              <c:Icon Width="16" Height="16" Margin="14,0,0,0" Foreground="{DynamicResource Rift.Dim}" Data="{StaticResource Icon.Search}" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ListBox x:Name="PaletteList" Classes="palette" ItemsSource="{Binding Palette.Results}"
                   SelectedIndex="{Binding Palette.SelectedIndex, Mode=TwoWay}" MaxHeight="420">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <DockPanel>
                  <c:Icon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,12,0" Foreground="{DynamicResource Rift.Muted}"
                          Data="{Binding Icon, Converter={x:Static app:Converters.ResourceToGeometry}}" />
                  <Border DockPanel.Dock="Right" Classes="kbd" IsVisible="{Binding HasGesture}" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Gesture}" />
                  </Border>
                  <TextBlock DockPanel.Dock="Right" Classes="dim" FontSize="11" Text="{Binding KindText}" VerticalAlignment="Center"
                             IsVisible="{Binding !HasGesture}" />
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="dim" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

    <!-- Settings (Ctrl+,) -->
    <v:SettingsView Grid.RowSpan="3" DataContext="{Binding Settings}" IsVisible="{Binding IsOpen}" />

    <!-- Modal dialog: conflicts, delete confirmation, errors -->
    <Border Grid.RowSpan="3" Background="{DynamicResource Rift.Scrim}"
            IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:DialogViewModel">
            <Border Classes="card" Width="500" Padding="20,18" Background="{DynamicResource Rift.Panel}" CornerRadius="12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                <ItemsControl ItemsSource="{Binding Details}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{Binding CheckBoxText}" IsChecked="{Binding IsChecked}" IsVisible="{Binding HasCheckBox}" />
                <TextBox x:Name="DialogInput" Text="{Binding Input, Mode=TwoWay}" IsVisible="{Binding HasInput}"
                         AttachedToVisualTree="OnDialogInputAttached" />
                <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,8,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DialogButton">
                      <Button Classes="dialog" Classes.primary="{Binding IsPrimary}" Classes.danger="{Binding IsDanger}"
                              Content="{Binding Label}"
                              Command="{Binding $parent[ItemsControl].((vm:DialogViewModel)DataContext).ChooseCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Border>
  </Grid>
</Window>
