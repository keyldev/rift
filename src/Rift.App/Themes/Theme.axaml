<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Палитра из design/RiftMockup.jsx. Ключи одинаковые в обеих темах, менять только значения. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Rift.Bg" Color="#111113" />
      <SolidColorBrush x:Key="Rift.Panel" Color="#18181B" />
      <SolidColorBrush x:Key="Rift.Raised" Color="#1F1F23" />
      <SolidColorBrush x:Key="Rift.Hover" Color="#26262B" />
      <SolidColorBrush x:Key="Rift.Line" Color="#2C2C31" />
      <SolidColorBrush x:Key="Rift.Text" Color="#EDEDEF" />
      <SolidColorBrush x:Key="Rift.Muted" Color="#A1A1AA" />
      <SolidColorBrush x:Key="Rift.Dim" Color="#6E6E78" />
      <SolidColorBrush x:Key="Rift.Accent" Color="#4C8DFF" />
      <SolidColorBrush x:Key="Rift.AccentBg" Color="#264C8DFF" />
      <SolidColorBrush x:Key="Rift.AccentBgHover" Color="#384C8DFF" />
      <SolidColorBrush x:Key="Rift.AccentLine" Color="#804C8DFF" />
      <SolidColorBrush x:Key="Rift.SelIdle" Color="#10FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Rift.Bg" Color="#F3F3F1" />
      <SolidColorBrush x:Key="Rift.Panel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Rift.Raised" Color="#F8F8F6" />
      <SolidColorBrush x:Key="Rift.Hover" Color="#EEEEEB" />
      <SolidColorBrush x:Key="Rift.Line" Color="#E3E3DF" />
      <SolidColorBrush x:Key="Rift.Text" Color="#1C1C1F" />
      <SolidColorBrush x:Key="Rift.Muted" Color="#5F5F67" />
      <SolidColorBrush x:Key="Rift.Dim" Color="#8F8F97" />
      <SolidColorBrush x:Key="Rift.Accent" Color="#2563EB" />
      <SolidColorBrush x:Key="Rift.AccentBg" Color="#262563EB" />
      <SolidColorBrush x:Key="Rift.AccentBgHover" Color="#382563EB" />
      <SolidColorBrush x:Key="Rift.AccentLine" Color="#802563EB" />
      <SolidColorBrush x:Key="Rift.SelIdle" Color="#0D000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="Rift.Font">Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

  <!-- Иконки: контуры в сетке 24×24, рисуются контролом Controls.Icon. -->
  <StreamGeometry x:Key="Icon.Folder">M3,7.5 C3,6.1 4.1,5 5.5,5 L9.6,5 L11.6,7 L18.5,7 C19.9,7 21,8.1 21,9.5 L21,16.5 C21,17.9 19.9,19 18.5,19 L5.5,19 C4.1,19 3,17.9 3,16.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.File">M7,3 L13.5,3 L19,8.5 L19,19 C19,20.1 18.1,21 17,21 L7,21 C5.9,21 5,20.1 5,19 L5,5 C5,3.9 5.9,3 7,3 Z M13.5,3 L13.5,8.5 L19,8.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Desktop">M3.5,5 L20.5,5 L20.5,16 L3.5,16 Z M9,20 L15,20 M12,16 L12,20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Download">M12,4 L12,15 M7,10 L12,15 L17,10 M5,20 L19,20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Document">M7,3 L13.5,3 L19,8.5 L19,19 C19,20.1 18.1,21 17,21 L7,21 C5.9,21 5,20.1 5,19 L5,5 C5,3.9 5.9,3 7,3 Z M9,13 L15,13 M9,17 L13,17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Home">M4,11 L12,4 L20,11 M6,9.5 L6,20 L18,20 L18,9.5 M10,20 L10,14 L14,14 L14,20</StreamGeometry>
  <StreamGeometry x:Key="Icon.Drive">M3,13 L5.5,6 L18.5,6 L21,13 Z M3,13 L3,18 L21,18 L21,13 M16.5,15.5 L17.5,15.5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Server">M4,4 L20,4 L20,10 L4,10 Z M4,14 L20,14 L20,20 L4,20 Z M7.5,7 L8.5,7 M7.5,17 L8.5,17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M19,12 L5,12 M11,6 L5,12 L11,18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Forward">M5,12 L19,12 M13,6 L19,12 L13,18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Up">M12,19 L12,5 M6,11 L12,5 L18,11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M19.5,12 A7.5,7.5 0 1 1 17.3,6.7 M19.5,4 L19.5,9 L14.5,9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M12,5 L12,19 M5,12 L19,12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Close">M7,7 L17,17 M17,7 L7,17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Chevron">M9.5,6 L15.5,12 L9.5,18</StreamGeometry>
  <StreamGeometry x:Key="Icon.Sun">M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8 Z M12,2.5 L12,4.5 M12,19.5 L12,21.5 M2.5,12 L4.5,12 M19.5,12 L21.5,12 M5.3,5.3 L6.7,6.7 M17.3,17.3 L18.7,18.7 M5.3,18.7 L6.7,17.3 M17.3,6.7 L18.7,5.3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Moon">M20,14.5 A8.5,8.5 0 1 1 9.5,4 A6.5,6.5 0 0 0 20,14.5 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Minimize">M5,12 L19,12</StreamGeometry>
  <StreamGeometry x:Key="Icon.Single">M4,5 L20,5 L20,19 L4,19 Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Split">M4,5 L20,5 L20,19 L4,19 Z M12,5 L12,19</StreamGeometry>
</ResourceDictionary>
