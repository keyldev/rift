<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Rift.App.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Rift.WindowBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Rift.Font}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Margin" Value="8,0,0,6" />
  </Style>

  <!-- Flat buttons: toolbars, tabs, sidebar. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.flat.on">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
  </Style>
  <Style Selector="Button.flat c|Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.nav c|Icon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>

  <Style Selector="ProgressBar.usage">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Rift.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>

  <!-- Pane (a group of tabs). The active one gets an accent border. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource Rift.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.pane.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.AccentLine}" />
  </Style>

  <!-- Tabs -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="10,6,4,7" />
    <Setter Property="Margin" Value="0,0,2,-1" />
    <Setter Property="MaxWidth" Value="200" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Border.pane.active ListBox.tabs ListBoxItem:selected c|Icon.tab">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.close, ListBox.tabs ListBoxItem:selected Button.close">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close c|Icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- File list -->
  <Style Selector="ListBox.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Hover}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBgHover}" />
  </Style>
  <Style Selector="Border.pane:not(.active) ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.SelIdle}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>

  <!-- Hidden and system files are drawn faded, like in Explorer. -->
  <Style Selector="ListBox.files DockPanel.hidden">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Column headers -->
  <Style Selector="Button.header">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
  </Style>
  <Style Selector="Button.header c|Icon.sort">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>
  <Style Selector="Thumb.resize">
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="-4,3,0,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Width="1" Background="{DynamicResource Rift.Line}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="Border.filterbar">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
    <Setter Property="Padding" Value="12,3,8,3" />
  </Style>

  <!-- Tag chips in the sidebar -->
  <Style Selector="Button.tagchip">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Dragging a tab over a pane -->
  <Style Selector="Border.tabdrop">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <!-- Preview pane -->
  <Style Selector="Border.preview">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource Rift.Bg}" />
  </Style>
  <Style Selector="Border.previewtext">
    <Setter Property="Background" Value="{DynamicResource Rift.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Command palette -->
  <Style Selector="TextBox.palette">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="12,12,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.palette:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
  </Style>
  <Style Selector="ListBox.palette">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.palette ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource Rift.Bg}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- The search box stays small next to the path and opens up while typing. -->
  <Style Selector="TextBox.search">
    <Setter Property="Width" Value="120" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.search:focus-within">
    <Setter Property="Width" Value="210" />
  </Style>
  <Style Selector="ProgressBar.busy">
    <Setter Property="MinHeight" Value="2" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="0,-2,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>

  <Style Selector="AutoCompleteBox.address">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="-4,0" />
  </Style>
  <Style Selector="AutoCompleteBox.address /template/ TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="AutoCompleteBox.address.error /template/ TextBox">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Danger}" />
  </Style>

  <Style Selector="Button.crumb">
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.dropzone">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Rift.Overlay}" />
  </Style>
  <Style Selector="Border.dropzone c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>
  <Style Selector="Border.dropzone.copy">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Ok}" />
  </Style>
  <Style Selector="Border.dropzone.copy c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Ok}" />
  </Style>

  <!-- Dialog buttons -->
  <Style Selector="Button.dialog">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Button.dialog:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Button.dialog.primary">
    <Setter Property="Background" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dialog.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dialog.danger">
    <Setter Property="Background" Value="{DynamicResource Rift.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dialog.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Danger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dialog.primary:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.dialog.danger:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Operation cards and dialogs float above the content. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
  </Style>

  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Last, so they beat the general rules above. -->
  <!-- A narrow pane keeps the path readable: view buttons go (they're on Ctrl+Shift+1..3 and in Ctrl+K) -->
  <Style Selector="Border.pane.narrow StackPanel.viewbuttons">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.pane.narrow TextBox.search">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Border.pane.narrow TextBox.search:focus-within">
    <Setter Property="Width" Value="180" />
  </Style>
</Styles>
