<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Rift.App.Controls">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Rift.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource Rift.Font}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Dim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Margin" Value="8,0,0,6" />
  </Style>

  <!-- Плоские кнопки: тулбары, вкладки, сайдбар. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.flat.on">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
  </Style>
  <Style Selector="Button.flat c|Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Button.nav c|Icon">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>

  <Style Selector="ProgressBar.usage">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Rift.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>

  <!-- Панель (группа вкладок). Активная подсвечена акцентом. -->
  <Style Selector="Border.pane">
    <Setter Property="Background" Value="{DynamicResource Rift.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.pane.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.AccentLine}" />
  </Style>

  <!-- Вкладки -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="10,6,4,7" />
    <Setter Property="Margin" Value="0,0,2,-1" />
    <Setter Property="MaxWidth" Value="200" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Muted}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Rift.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>
  <Style Selector="Border.pane.active ListBox.tabs ListBoxItem:selected c|Icon.tab">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Accent}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover Button.close, ListBox.tabs ListBoxItem:selected Button.close">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem Button.close c|Icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>

  <!-- Список файлов -->
  <Style Selector="ListBox.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.Hover}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBg}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.AccentBgHover}" />
  </Style>
  <Style Selector="Border.pane:not(.active) ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Rift.SelIdle}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Rift.Text}" />
  </Style>

  <Style Selector="Button.crumb">
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
